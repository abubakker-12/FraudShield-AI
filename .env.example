# Offline default. Set LLM_PROVIDER=groq and configure both Groq fields for cloud explanations.
LLM_PROVIDER=python
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=8
OLLAMA_TIMEOUT_SECONDS=90
LLM_REQUESTS_PER_MINUTE=5
DATABASE_PATH=database/fraudshield.db
FRAUDSHIELD_USE_LOCAL_DATA=0
FRAUDSHIELD_PUBLIC_DEMO=0
# Optional public footer details.
FRAUDSHIELD_CONTACT_NAME=
FRAUDSHIELD_CONTACT_EMAIL=
FRAUDSHIELD_CONTACT_PHONE=
FRAUDSHIELD_CONTACT_LINKEDIN=
